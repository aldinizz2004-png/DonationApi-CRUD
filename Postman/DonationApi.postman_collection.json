							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"const page1 = JSON.parse(pm.collectionVariables.get(\"page1Ids\"));",
									"const ids = JSON.parse(pm.collectionVariables.get(\"pagingIds\"));",
									"pm.test(\"No duplicates from page 1, even after a new donation was inserted\", () => {",
									"    body.items.forEach(d => pm.expect(page1).to.not.include(d.id));",
									"});",
									"pm.test(\"The new donation does not shift the pages\", () => {",
									"    pm.expect(body.items.map(d => d.id)).to.not.include(Number(pm.collectionVariables.get(\"driftId\")));",
									"});",
									"pm.test(\"Page 2 continues exactly where page 1 ended\", () => {",
									"    pm.expect(body.items[0].id).to.eql(ids[0]);",
									"    pm.expect(new Date(body.items[0].createdAt) <= new Date(pm.collectionVariables.get(\"page1LastCreatedAt\"))).to.be.true;",
