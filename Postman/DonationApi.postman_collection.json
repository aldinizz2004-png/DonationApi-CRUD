									"    method: \"POST\",",
									"    header: { \"Content-Type\": \"application/json\" },",
									"    body: { mode: \"raw\", raw: JSON.stringify({ amount: 30, donorName: \"Paging New Arrival\", isAnonymous: false }) }",
									"}, (err, res) => pm.collectionVariables.set(\"driftId\", res.json().id));"
								]
							}
						},
