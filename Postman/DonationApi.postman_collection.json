		{
			"name": "Get All Donations",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
							"const body = pm.response.json();",
							"pm.test(\"Response is a page: items + metadata\", () => {",
							"    pm.expect(body.items).to.be.an(\"array\");",
							"    pm.expect(body.pageSize).to.eql(20);",
							"    pm.expect(body).to.have.property(\"hasNextPage\");",
							"    pm.expect(body).to.have.property(\"nextCursor\");",
							"});",
							"pm.test(\"Anonymous donation is masked in the list\", () => {",
							"    const anon = body.items.find(d => d.id === Number(pm.collectionVariables.get(\"anonId\")));",
							"    pm.expect(anon, \"the new anonymous donation is on the first page\").to.exist;",
							"    pm.expect(anon.donorName).to.eql(\"Anonymous\");",
							"});",
							"pm.test(\"Real anonymous name is NOT in the list\", () => pm.expect(pm.response.text()).to.not.include(\"Secret Donor\"));"
						]
					}
				}
			],
