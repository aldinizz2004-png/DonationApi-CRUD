		{
			"name": "Pagination",
			"description": "Keyset (cursor) pagination on GET /api/donations: first page, next page with cursor, a new donation inserted between pages (no duplicates), oldest sort + filters + total, and validation errors.",
			"item": [
				{
					"name": "Paging - First Page",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Create 3 donations so the paging tests do not depend on existing data (removed in \"Paging - Cleanup\").",
									"const make = (name, anon) => ({",
									"    url: pm.collectionVariables.get(\"baseUrl\") + \"/api/donations\",",
									"    method: \"POST\",",
									"    header: { \"Content-Type\": \"application/json\" },",
									"    body: { mode: \"raw\", raw: JSON.stringify({ amount: 75, donorName: name, isAnonymous: anon }) }",
									"});",
									"const ids = [];",
									"pm.sendRequest(make(\"Paging Test A\", false), (e1, r1) => {",
									"    ids.push(r1.json().id);",
									"    pm.sendRequest(make(\"Paging Test B\", false), (e2, r2) => {",
									"        ids.push(r2.json().id);",
									"        pm.sendRequest(make(\"Paging Secret Donor\", true), (e3, r3) => {",
									"            ids.push(r3.json().id);",
									"            pm.collectionVariables.set(\"pagingIds\", JSON.stringify(ids));",
									"        });",
									"    });",
									"});"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.test(\"Exactly pageSize items\", () => {",
									"    pm.expect(body.pageSize).to.eql(2);",
									"    pm.expect(body.items.length).to.eql(2);",
									"});",
									"pm.test(\"hasNextPage = true and an opaque nextCursor is returned\", () => {",
									"    pm.expect(body.hasNextPage).to.eql(true);",
									"    pm.expect(body.nextCursor).to.be.a(\"string\").and.not.empty;",
									"});",
									"pm.test(\"totalCount is not computed unless includeTotal=true\", () => pm.expect(body.totalCount).to.eql(null));",
									"pm.test(\"Newest first: the 2 donations just created\", () => {",
									"    const ids = JSON.parse(pm.collectionVariables.get(\"pagingIds\"));",
									"    pm.expect(body.items.map(d => d.id)).to.eql([ids[2], ids[1]]);",
									"});",
									"pm.test(\"Anonymous donor is masked inside the page\", () => {",
									"    pm.expect(body.items[0].isAnonymous).to.eql(true);",
									"    pm.expect(body.items[0].donorName).to.eql(\"Anonymous\");",
