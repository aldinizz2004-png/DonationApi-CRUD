# Copy this file to ".env" and set your own values. ".env" is git-ignored.

# SQL Server "sa" password. Rules: at least 8 characters, with upper case, lower case, digits and symbols.
# Avoid ; " ' $ and # (they break the connection string or the .env parser).
DB_PASSWORD=ChangeMe_Strong_Password1!

# Database name created by the EF Core migrations
DB_NAME=DonationDb

# Host ports (left side of "host:container")
API_PORT=5207
DB_HOST_PORT=14333

# Development = Swagger UI enabled at /swagger
ASPNETCORE_ENVIRONMENT=Development
